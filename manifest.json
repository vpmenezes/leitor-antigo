{
  "name": "Leitor Antigo",
  "short_name": "Leitor",
  "description": "Estante e leitor de livros EPUB com visual de livro antigo",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1d120b",
  "theme_color": "#160c06",
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "livro", "accept": ["application/epub+zip", "application/octet-stream", ".epub"] }
      ]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
